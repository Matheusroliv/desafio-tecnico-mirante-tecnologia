# --- Banco da pipeline (historico) e banco legado da metrica de equivalencia ---
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/pipeline
LEGACY_DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/legacy

# --- LLM (qualquer provedor compativel com a API de chat da OpenAI) ---
# OpenAI:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1
# Ollama local (sem custo): OPENAI_API_KEY=ollama, OPENAI_BASE_URL=http://localhost:11434/v1,
# OPENAI_MODEL=qwen2.5-coder:14b e OPENAI_EXTRA_BODY={"options":{"num_ctx":16384}}
OPENAI_EXTRA_BODY=
# Dentro do Docker, "localhost" e o proprio container. Para um Ollama no host use:
# DOCKER_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
DOCKER_OPENAI_BASE_URL=

# Reparos permitidos depois da primeira geracao (validate -> generate)
MAX_REPAIR_ATTEMPTS=1

# --- Langfuse self-hosted (docker compose --profile observability up) ---
# Chaves de DESENVOLVIMENTO criadas pela inicializacao headless do compose. Nao sao segredo de producao.
# Deixe as duas vazias para desligar o tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
LANGFUSE_SECRET_KEY=sk-lf-local-dev
LANGFUSE_HOST=http://localhost:3000
